---
import '../styles/tokens.css';
import '../styles/type.css';
import '../styles/globals.css';
import '../styles/effects.css';

import '@fontsource/space-grotesk/300.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Starfield } from "../components/effects/Starfield";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;

/* `Astro.site` sale de astro.config.mjs. El fallback evita que reviente si
   se compila sin él. */
const base = Astro.site ?? new URL('https://mizarium.com');
const canonical = new URL(Astro.url.pathname, base);
const ogImage = new URL('/og.png', base);
---

<!doctype html>
<html lang="es" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Iconos. Generados por scripts/gen-brand-assets.cjs -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0B0F1A" />

    <!-- Compartir. Sin esto, un enlace a la web no muestra nada en
         WhatsApp ni en LinkedIn. -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Mizarium" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mizarium — estudio digital" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>

  <body class="relative min-h-screen overflow-x-hidden bg-background-dark text-white font-sans">

    <!-- HEADER -->
    <Header />
	
	<!-- Fondo nebular -->
    <div class="fixed inset-0 z-0 nebula-glow"></div>

    <!-- Campo de estrellas -->
    <Starfield client:only="react" />

    <!-- Contenido de la página -->
    <div class="relative z-10 flex flex-col min-h-screen">
      <slot />
      <Footer />
    </div>

  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  /* El header es fijo y mide ~6rem con su offset superior. Sin esto, los
     enlaces de ancla dejan el título de cada sección debajo del header. */
  section[id] {
    scroll-margin-top: 7rem;
  }

  .social-icon-glow {
    @apply transition-all duration-300 hover:text-primary;
    filter: drop-shadow(0 0 2px rgb(var(--brand) / 0.3));
  }

  .mission-type-card.active {
    @apply border-primary bg-primary/10;
  }

  .mission-type-card.active svg {
    @apply text-primary;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>
