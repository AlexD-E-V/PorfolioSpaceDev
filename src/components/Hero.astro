---
import Icon from './ui/Icon.astro';

/* Hero centrado. La columna derecha asimétrica del sitio viejo se retiró:
   ahí vivían las métricas inventadas ("LATENCIA_MS 0.0012", "4.2 TB/S") y una
   tarjeta de "proyecto actual", que es lenguaje de portafolio. La tira de
   capacidades de abajo hace su trabajo — mostrar amplitud — sin desviar la
   atención del CTA. Ver docs/MIZARIUM.md §5. */

const CAPABILITIES = [
  'Web & e-commerce',
  'Apps móviles',
  'Videojuegos',
  'VR / AR',
  'Software a medida',
];
---

<section id="inicio" class="relative w-full pt-36 pb-24 md:pt-44 md:pb-28">
  <div class="shell text-center">

    <!-- Estado -->
    <div
      class="inline-flex items-center gap-2.5 rounded-full border border-primary/25 bg-primary/[0.06] px-4 py-1.5"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"></span>
      </span>
      <span class="eyebrow">Estudio digital multidisciplinar</span>
    </div>

    <!-- Título -->
    <h1 class="display-1 mt-8 mx-auto max-w-[16ch]">
      Lo que imaginas,
      <span class="text-cosmic">construido</span>.
    </h1>

    <!-- Bajada: nombra la web primero, que es lo que se vende -->
    <p class="lede mx-auto mt-8">
      Diseñamos y programamos <strong class="font-semibold text-ink-50"
        >páginas web que venden</strong
      > — y desde ahí, apps, videojuegos y experiencias inmersivas. Un solo
      equipo, del primer boceto al despliegue.
    </p>

    <!-- CTAs -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#contacto"
        class="group flex items-center gap-2.5 rounded-full bg-primary px-8 py-4 text-base font-bold text-on-primary shadow-glow-lg transition-all hover:bg-star-300 hover:scale-[1.03] active:scale-95"
      >
        Empezar un proyecto
        <Icon name="arrow_forward" class="transition-transform group-hover:translate-x-1" />
      </a>

      <a
        href="#servicios"
        class="group flex items-center gap-2.5 rounded-full border border-ink-600 bg-white/[0.04] px-7 py-4 text-base font-semibold backdrop-blur-sm transition-all hover:border-ink-400 hover:bg-white/[0.07]"
      >
        Ver lo que hacemos
        <Icon name="keyboard_arrow_down" class="text-primary transition-transform group-hover:translate-y-0.5" />
      </a>
    </div>

    <!-- Tira de capacidades -->
    <ul
      class="mt-16 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 font-mono text-[10px] uppercase tracking-[0.16em] text-slate-400"
    >
      {
        CAPABILITIES.map((cap, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="text-primary/40">✦</li>}
            <li>{cap}</li>
          </>
        ))
      }
    </ul>
  </div>
</section>
