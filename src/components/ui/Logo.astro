---
/* Logotipo de Mizarium.

   Los SVG originales de Illustrator viven en src/assets/logos/ y vienen con
   un color fijo (#1d2331 el iso, #fff los demás). Aquí se les quita ese
   relleno y se sustituye por currentColor, así que el color lo manda el CSS:

     <Logo variant="lockup" class="h-8 text-primary" />   → oro
     <Logo variant="iso"    class="h-6 text-ink-50" />    → blanco

   Para cambiar un logo basta con reemplazar su archivo: no hay paths
   copiados dentro de ningún componente.

   VARIANTES (proporción ancho/alto entre paréntesis)
     iso              solo la estrella                       (0.82)
     wordmark         solo el nombre, una línea             (11.57)
     wordmark-stacked solo el nombre, dos líneas             (2.58)
     lockup           estrella + nombre en una línea         (4.83)
     lockup-compact   estrella + nombre en dos líneas        (2.90)
     lockup-vertical  estrella encima del nombre             (0.75)

   Las proporciones importan al elegir: `lockup` es muy apaisado y se queda
   diminuto en espacios estrechos; ahí funciona mejor `lockup-compact`. */

import iso from '../../assets/logos/iso.svg?raw';
import wordmark from '../../assets/logos/wordmark.svg?raw';
import wordmarkStacked from '../../assets/logos/wordmark-stacked.svg?raw';
import lockup from '../../assets/logos/lockup.svg?raw';
import lockupCompact from '../../assets/logos/lockup-compact.svg?raw';
import lockupVertical from '../../assets/logos/lockup-vertical.svg?raw';

/* Sin `export`: exportar una unión de tipos desde el frontmatter de un .astro
   pasa `astro check` pero revienta el build (esbuild no la digiere). */
type LogoVariant = 'iso' | 'wordmark' | 'wordmark-stacked' | 'lockup' | 'lockup-compact' | 'lockup-vertical';

interface Props {
  variant?: LogoVariant;
  class?: string;
  /** Texto alternativo. Si se omite, el logo es decorativo (aria-hidden). */
  label?: string;
}

const SOURCES: Record<LogoVariant, string> = {
  iso,
  wordmark,
  'wordmark-stacked': wordmarkStacked,
  lockup,
  'lockup-compact': lockupCompact,
  'lockup-vertical': lockupVertical,
};

const { variant = 'lockup', class: className = 'h-8 w-auto', label } = Astro.props;

const a11y = label
  ? `role="img" aria-label="${label}"`
  : 'role="presentation" aria-hidden="true"';

const svg = SOURCES[variant]
  /* Sin width/height el SVG toma su proporción del viewBox y se deja
     dimensionar por CSS. */
  .replace(/\s(?:width|height)="[^"]*"/g, '')
  /* Fuera el color quemado — pero se respeta fill="none", que en algunos
     logos marca huecos y no un relleno. */
  .replace(/\sfill="(?!none)[^"]*"/g, '')
  .replace(/<svg\b/, `<svg fill="currentColor" class="${className}" ${a11y}`);
---

<Fragment set:html={svg} />
