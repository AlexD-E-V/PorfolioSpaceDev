---
import type { TeamMember } from '../../data/team';
import MemberPortrait from './MemberPortrait.astro';
import SocialLink from './SocialLink.astro';

interface Props {
  member: TeamMember;
}

const { member } = Astro.props;
const socials = Object.entries(member.socials) as [
  keyof TeamMember['socials'],
  string,
][];
---

<article
  class="glass-card rounded-2xl p-7 flex flex-col sm:flex-row gap-6 items-center sm:items-start text-center sm:text-left group transition-all duration-500 relative"
>
  {socials.length > 0 && (
    <div class="absolute top-6 right-6 flex gap-3">
      {socials.map(([network, href]) => (
        <SocialLink network={network} href={href} name={member.name} />
      ))}
    </div>
  )}

  <div class="relative shrink-0">
    <div
      class="absolute inset-0 rounded-full bg-primary/15 blur-xl group-hover:bg-primary/30 transition-all"
    >
    </div>
    <MemberPortrait member={member} size="size-28" />
  </div>

  <div class="flex-1 space-y-3 min-w-0">
    <div class="flex items-center justify-center sm:justify-start gap-2">
      <span
        class="text-[10px] font-mono text-primary border border-primary/40 px-2 py-0.5 rounded"
      >
        {member.code}
      </span>
      <span class="text-[10px] font-mono text-slate-400 uppercase tracking-wider">
        {member.area}
      </span>
    </div>

    {/* `h3`: el equipo cuelga directamente del `h2` de Nosotros, sin título
        de bloque intermedio. */}
    <h3 class="text-2xl font-bold tracking-tight">{member.name}</h3>

    <div class="flex flex-wrap justify-center sm:justify-start gap-2">
      <span
        class="bg-primary/10 text-primary text-[10px] font-bold px-3 py-1 rounded-full border border-primary/20 uppercase"
      >
        {member.role}
      </span>
      {member.secondaryRole && (
        <span
          class="bg-white/5 text-slate-400 text-[10px] font-bold px-3 py-1 rounded-full border border-white/10 uppercase"
        >
          {member.secondaryRole}
        </span>
      )}
    </div>

    <p class="text-slate-400 text-sm italic leading-relaxed text-pretty">
      {member.focus}
    </p>
  </div>
</article>
