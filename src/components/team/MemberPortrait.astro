---
/* Retrato de un miembro. Si todavía no hay foto propia, pinta la inicial en
   vez de dejar un hueco o depender de una imagen externa. */
import type { TeamMember } from '../../data/team';

interface Props {
  member: TeamMember;
  /** Tamaño del marco en unidades de Tailwind (size-32, size-40…). */
  size: string;
}

const { member, size } = Astro.props;
---

<div
  class:list={[
    'relative overflow-hidden rounded-full border-2 border-primary/30 bg-background-dark p-1.5',
    size,
  ]}
>
  {member.photo ? (
    <div
      class="w-full h-full rounded-full bg-cover bg-center portrait-filter transition-all duration-500 ease-out group-hover:filter-none"
      style={`background-image: url('${member.photo}');`}
      role="img"
      aria-label={`Retrato de ${member.name}`}
    >
    </div>
  ) : (
    <div
      class="w-full h-full rounded-full flex items-center justify-center bg-primary/10 text-4xl font-bold text-primary/70"
      aria-hidden="true"
    >
      {member.name.charAt(0)}
    </div>
  )}

  <div
    class="absolute inset-0 rounded-full brand-tint mix-blend-overlay opacity-100 group-hover:opacity-0 transition-opacity duration-500"
  >
  </div>
</div>
