---
import Icon from './ui/Icon.astro';
import { PRIMARY_SERVICE, SECONDARY_SERVICES } from '../data/services';

/* El movimiento que reposiciona la página entera: la web ocupa una tarjeta
   grande con entregables y CTA propio, y el resto son cuatro tarjetas
   pequeñas al lado. Visualmente queda claro qué se vende y qué es extensión.

   Antes esto era `Matriz.astro`, cuatro tarjetas iguales con un párrafo
   genérico cada una y nada que un comprador pudiera evaluar. */

/* Movimiento del icono decorativo, uno distinto por tarjeta. Es un detalle
   que venía de Space DEV: cada recuadro giraba hacia un lado diferente al
   pasar por encima, y eso hacía que la rejilla no se sintiera repetida.

   Van como cadenas literales completas y no montadas por concatenación
   porque Tailwind rastrea el texto del archivo: si construyera las clases
   pegando trozos, no generaría el CSS. */
const TILTS = [
  'group-hover:rotate-12 group-hover:translate-x-1.5 group-hover:-translate-y-1',
  'group-hover:-rotate-6 group-hover:-translate-x-1 group-hover:-translate-y-1.5',
  'group-hover:rotate-6 group-hover:translate-x-1 group-hover:translate-y-1.5',
  'group-hover:-rotate-12 group-hover:-translate-x-1.5 group-hover:-translate-y-1',
];
---

<section id="servicios" class="relative w-full py-24 md:py-28">
  <div class="shell">

    <!-- Cabecera -->
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Servicios</p>
        <h2 class="display-2 mt-4 max-w-[18ch]">Diversidad para tu idea</h2>
      </div>
      <p class="body-text max-w-[38ch] text-[0.95rem]">
        Hay muchas formas de hacer realidad una marca, un proyecto o un
        emprendimiento. Cada servicio se contrata solo o encadenado con los
        demás.
      </p>
    </div>

    <!-- Servicio principal + secundarios -->
    <div class="mt-12 grid gap-5 lg:grid-cols-2">

      <!-- Web -->
      <article
        class="glass-card group relative overflow-hidden rounded-2xl p-8 md:p-10 !border-primary/35"
      >
        <div class="scanline"></div>

        <!-- Icono decorativo de fondo. Mismo gesto que en las secundarias,
             algo más amplio porque la tarjeta es mucho mayor. -->
        <div
          class="pointer-events-none absolute -right-8 -top-8 text-primary opacity-[0.06] transition-all duration-700 ease-out will-change-transform group-hover:scale-110 group-hover:rotate-6 group-hover:translate-x-2 group-hover:-translate-y-2 group-hover:opacity-[0.13]"
          aria-hidden="true"
        >
          <Icon name={PRIMARY_SERVICE.icon} class="text-[190px]" />
        </div>

        <div class="relative">
          <span
            class="inline-block rounded-full bg-primary px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-on-primary"
          >
            {PRIMARY_SERVICE.badge}
          </span>

          <h3 class="display-3 mt-6">{PRIMARY_SERVICE.title}</h3>

          <p class="body-text mt-4 max-w-[46ch]">
            {PRIMARY_SERVICE.description}
          </p>

          <ul class="mt-7 grid gap-x-6 gap-y-2.5 sm:grid-cols-2">
            {
              PRIMARY_SERVICE.deliverables.map((d) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-50">
                  <span class="mt-[3px] text-primary" aria-hidden="true">✦</span>
                  {d}
                </li>
              ))
            }
          </ul>

          <a
            href="#contacto"
            class="group/cta mt-8 inline-flex items-center gap-2 text-sm font-bold text-primary transition-colors hover:text-star-300"
          >
            {PRIMARY_SERVICE.cta}
            <Icon name="arrow_forward" class="transition-transform group-hover/cta:translate-x-1.5" />
          </a>
        </div>
      </article>

      <!-- Resto -->
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
        {
          SECONDARY_SERVICES.map((s, i) => (
            <article class="glass-card group relative overflow-hidden rounded-2xl p-6">
              {/* Icono grande de fondo, como en Space DEV. Cada tarjeta gira
                  hacia un lado distinto para que la rejilla no se sienta
                  repetida. */}
              <div
                class:list={[
                  'pointer-events-none absolute -right-7 -top-7 text-primary opacity-[0.06]',
                  'transition-all duration-700 ease-out will-change-transform',
                  'group-hover:scale-110 group-hover:opacity-[0.13]',
                  TILTS[i % TILTS.length],
                ]}
                aria-hidden="true"
              >
                <Icon name={s.icon} class="text-[130px]" />
              </div>

              <div class="relative">
                <div class="flex size-10 items-center justify-center rounded-lg border border-primary/20 bg-primary/10 text-primary transition-transform group-hover:scale-110">
                  <Icon name={s.icon} class="text-xl" />
                </div>
                <h3 class="mt-5 text-lg font-bold tracking-tight">{s.title}</h3>
                <p class="body-text mt-2.5 text-sm">{s.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>
