---
import Icon from './ui/Icon.astro';
import { PHASES, DISCIPLINES } from '../data/method';

/* El método absorbe lo que en el diseño de referencia era una sección aparte
   ("Sistema Mizar"). El argumento de "un solo equipo, sin traspasos" es un
   argumento de método: aquí es donde pertenece, y así son cinco secciones y
   no seis. Ver docs/MIZARIUM.md §5. */
---

<section id="metodo" class="relative w-full py-24 md:py-28">
  <div class="shell">

    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Método</p>
        <h2 class="display-2 mt-4 max-w-[20ch]">De una idea vaga a algo que funciona</h2>
      </div>
      <p
        class="flex items-center gap-2.5 rounded-full border border-primary/25 bg-primary/[0.06] px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-primary"
      >
        <Icon name="check_circle" class="text-sm" />
        Presupuesto cerrado por escrito
      </p>
    </div>

    <!-- Fases -->
    <ol class="mt-12 grid border-t border-ink-600 sm:grid-cols-2 lg:grid-cols-4">
      {
        PHASES.map((p, i) => (
          <li
            class:list={[
              'group relative px-0 py-8 sm:px-7 lg:px-6',
              i === 0 && 'sm:pl-0 lg:pl-0',
              i !== PHASES.length - 1 && 'lg:border-r border-ink-600',
              i === 0 && 'sm:border-r',
              i === 2 && 'sm:border-r lg:border-r',
            ]}
          >
            {/* Línea que se enciende al pasar por encima */}
            <span
              class="absolute left-0 top-[-1px] h-px w-0 bg-primary transition-all duration-700 group-hover:w-full"
              aria-hidden="true"
            />

            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-400">
              {p.step} — {p.when}
            </p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight transition-colors group-hover:text-primary">
              {p.title}
            </h3>
            <p class="body-text mt-2.5 text-sm">{p.description}</p>
          </li>
        ))
      }
    </ol>

    <!-- Sistema Mizar -->
    <div
      class="glass-panel relative mt-16 overflow-hidden rounded-2xl p-8 md:p-12"
    >
      <div class="scanline"></div>

      <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
        <div>
          <p class="eyebrow">El sistema Mizar</p>
          <h3 class="display-3 mt-4">Cuatro estrellas. Un solo punto de luz.</h3>
          <p class="body-text mt-5">
            Mizar parece una estrella y en realidad son cuatro. Igual que
            nosotros: diseño, código, producto y tiempo real trabajando por
            separado y llegándote como un producto único. Sin intermediarios,
            sin traspasos, sin «eso lo lleva otro equipo».
          </p>
        </div>

        <div class="grid gap-3.5 sm:grid-cols-2">
          {
            DISCIPLINES.map((d) => (
              <div class="group rounded-xl border border-ink-600 bg-ink-800/70 p-5 transition-all duration-300 hover:border-primary/45">
                <div class="flex items-center justify-between">
                  <span class="font-mono text-lg text-primary">{d.n}</span>
                  <Icon
                    name={d.icon}
                    class="text-lg text-slate-400 transition-colors group-hover:text-primary"
                  />
                </div>
                <p class="mt-3 text-sm font-semibold leading-snug">{d.title}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
