---
import Icon from './ui/Icon.astro';
import { PHASES } from '../data/method';

/* Las cuatro fases responden a la objeción principal para contratar un
   estudio pequeño: no saber qué va a pasar ni cuánto va a costar.

   Aquí cerraba antes un bloque "Sistema Mizar" con las cuatro disciplinas.
   Se retiró por decisión del cliente: sobraba y alargaba la sección. */
---

<section id="metodo" class="relative w-full py-24 md:py-28">
  <div class="shell">

    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Método</p>
        <h2 class="display-2 mt-4 max-w-[20ch]">De una idea vaga a algo que funciona</h2>
      </div>
      <p
        class="flex items-center gap-2.5 rounded-full border border-primary/25 bg-primary/[0.06] px-4 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-primary"
      >
        <Icon name="check_circle" class="text-sm" />
        Presupuesto cerrado por escrito
      </p>
    </div>

    <!-- Fases -->
    <ol class="mt-12 grid border-t border-ink-600 sm:grid-cols-2 lg:grid-cols-4">
      {
        PHASES.map((p, i) => (
          <li
            class:list={[
              'group relative px-0 py-8 sm:px-7 lg:px-6',
              i === 0 && 'sm:pl-0 lg:pl-0',
              i !== PHASES.length - 1 && 'lg:border-r border-ink-600',
              i === 0 && 'sm:border-r',
              i === 2 && 'sm:border-r lg:border-r',
            ]}
          >
            {/* Línea que se enciende al pasar por encima */}
            <span
              class="absolute left-0 top-[-1px] h-px w-0 bg-primary transition-all duration-700 group-hover:w-full"
              aria-hidden="true"
            />

            <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-slate-400">
              {p.step} — {p.when}
            </p>
            <h3 class="mt-4 text-2xl font-bold tracking-tight transition-colors group-hover:text-primary">
              {p.title}
            </h3>
            <p class="body-text mt-2.5 text-sm">{p.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
