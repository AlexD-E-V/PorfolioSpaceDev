---
import Icon from './ui/Icon.astro';
import MemberCard from './team/MemberCard.astro';
import { PROJECTS, PORTFOLIO_URL } from '../data/projects';
import { TEAM } from '../data/team';

/* Antes esto era `Archivos.tsx`: filtros por categoría, expandir/colapsar,
   SIGNAL_MAP y framer-motion entero para animar la rejilla — la sección más
   trabajada del sitio, y la que más lo hacía parecer un portafolio.

   Y en su primera versión aquí seguía pesando demasiado texto: cada tarjeta
   mostraba a la vez papel, año, descripción, resultado, stack y enlace. Ahora
   manda la imagen; lo demás aparece encima al pasar por el cursor.

   La rejilla usa `columns` (multicolumna CSS) en vez de `grid` para que las
   tarjetas se empaqueten según su altura real y quede escalonada, como en la
   referencia. Con `grid` y márgenes forzados se abrían huecos entre filas. */

const ACCENTS = {
  /* Contrastes comprobados sobre cada fondo: oro 10.9:1, cian 12.3:1 y
     violeta 6.4:1 con texto blanco (en violeta el texto oscuro fallaría). */
  gold: 'bg-star-500 text-on-primary',
  cyan: 'bg-cosmic-cyan text-ink-950',
  violet: 'bg-cosmic-violet text-white',
} as const;
---

<section id="trabajo" class="relative w-full py-24 md:py-28">
  <div class="shell">

    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="eyebrow">Trabajo reciente</p>
        <h2 class="display-2 mt-4">Casos, no galería</h2>
      </div>
      <p class="body-text max-w-[36ch] text-[0.95rem]">
        Enseñamos pocos a propósito: los que explican cómo trabajamos y qué
        consiguieron.
      </p>
    </div>

    <!-- Rejilla escalonada: la columna de la derecha arranca más abajo.

         La versión anterior usaba `columns` (multicolumna CSS) esperando que
         se empaquetara sola, pero con solo dos casos de altura parecida el
         resultado quedaba plano, en línea. Con `grid` + `items-start` el
         desfase se controla a mano y siempre ocurre. -->
    <div class="mt-12 grid gap-x-8 gap-y-12 lg:grid-cols-2 lg:items-start">
      {
        PROJECTS.map((p, i) => (
          <article class:list={['group', i % 2 === 1 && 'lg:mt-24']}>
            <div
              class:list={[
                'relative overflow-hidden rounded-2xl border border-ink-600 transition-colors duration-500 group-hover:border-primary/40',
                p.aspect,
              ]}
            >
              <div
                class="absolute inset-0 bg-cover bg-center transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                style={`background-image: url('${p.image}')`}
                role="img"
                aria-label={`Captura de ${p.title}`}
              />

              {/* Velo permanente, muy suave, para que la píldora se lea
                  siempre sobre cualquier imagen. */}
              <div
                class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/70 to-transparent"
                aria-hidden="true"
              />

              {/* La píldora va ANTES del overlay a propósito: al revelarse,
                  el overlay la tapa sin necesidad de desvanecerla aparte.
                  La primera versión usaba `lg:group-hover:opacity-0` para
                  ocultarla, pero Tailwind no llegaba a generar esa variante
                  apilada y la píldora se quedaba flotando encima. */}
              <span
                class:list={[
                  'absolute bottom-4 left-4 rounded-full px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.1em]',
                  ACCENTS[p.accent],
                ]}
              >
                {p.category}
              </span>

              {/* Ficha que sube al pasar por encima. En pantallas sin cursor
                  no aparece: ahí los datos van debajo, ver más abajo. */}
              <div
                class="pointer-events-none absolute inset-0 hidden flex-col justify-end bg-gradient-to-t from-ink-950 via-ink-950/85 to-transparent p-6 opacity-0 transition-opacity duration-500 group-hover:opacity-100 lg:flex"
              >
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">
                  {p.role} · {p.year}
                </p>
                <p class="mt-2 text-[0.95rem] leading-snug text-ink-50">
                  {p.result}
                </p>
                <p class="mt-3 font-mono text-[10px] text-slate-400">{p.tech}</p>

                {p.url && (
                  <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-bold text-primary">
                    Visitar
                    <Icon name="travel_explore" class="text-sm" />
                  </span>
                )}
              </div>

              {/* La tarjeta entera es el enlace, pero el nombre accesible lo
                  da este enlace invisible: así no hay que repetir texto. */}
              {p.url && (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0"
                  aria-label={`Ver ${p.title} (se abre en una pestaña nueva)`}
                />
              )}
            </div>

            <h3 class="mt-5 text-xl font-bold tracking-tight transition-colors group-hover:text-primary">
              {p.title}
            </h3>
            <p class="body-text mt-1.5 text-sm">{p.hook}</p>

            {/* Sin cursor no hay hover, así que lo que arriba se revela al
                pasar por encima aquí se muestra siempre. El resultado va
                incluido a propósito: es el dato que de verdad vende y en
                móvil no habría ninguna otra forma de verlo. */}
            <div class="lg:hidden">
              <p class="mt-2.5 text-sm text-ink-50">{p.result}</p>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.12em] text-slate-400">
                {p.role} · {p.year} · {p.tech}
              </p>
            </div>
          </article>
        ))
      }
    </div>

    {/* Portafolio personal, FUERA de la rejilla y centrado.

        Antes era una tarjeta más dentro de la retícula, así que caía debajo
        de la columna más corta y dejaba un hueco enorme al lado. Sacándola
        y centrándola cierra la sección en vez de descuadrarla. */}
    <div class="mt-16 flex justify-center">
      <a
        href={PORTFOLIO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card group flex w-full max-w-xl flex-col items-center gap-3 rounded-2xl p-8 text-center"
      >
        <Icon name="explore" class="text-3xl text-primary" />
        <h3 class="text-xl font-bold tracking-tight">¿Quieres ver más?</h3>
        <p class="body-text mx-auto text-sm">
          El resto del trabajo, con cada caso desglosado, está en el portafolio
          personal de Alex.
        </p>
        <span
          class="mt-1 inline-flex items-center gap-2 text-sm font-bold text-primary transition-all group-hover:gap-3.5"
        >
          Abrir portafolio
          <Icon name="arrow_forward" />
        </span>
      </a>
    </div>

    <!-- Quién lo hizo -->
    <div class="mt-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Quién está detrás</p>
          <h3 class="display-3 mt-3">Dos personas, cuatro disciplinas</h3>
        </div>
        <p class="body-text max-w-[34ch] text-sm">
          Trabajamos desde la latitud 0°, el punto donde empiezan las
          coordenadas.
        </p>
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        {TEAM.map((member) => <MemberCard member={member} />)}
      </div>
    </div>
  </div>
</section>
