---
import Icon from './ui/Icon.astro';
import { PROJECTS, PORTFOLIO_URL } from '../data/projects';

/* Antes esto era `Archivos.tsx`: filtros por categoría, expandir/colapsar,
   SIGNAL_MAP y framer-motion entero para animar la rejilla — la sección más
   trabajada del sitio, y la que más lo hacía parecer un portafolio.

   La tarjeta replica la de docs/ref/newref.html: proporción 4/5 fija, imagen
   a sangre con zoom al pasar por encima, degradado permanente, píldora de
   color apoyada abajo a la izquierda, y debajo título y una sola línea.

   Diferencias respecto a esa referencia, y por qué:
     · El desfase alterna −48/+48 px en vez de empujar solo una columna, así
       el bloque queda equilibrado respecto a su eje.
     · Se añade el RESULTADO al pasar por encima. La referencia no lo tiene,
       pero es el dato que de verdad vende; aparece sin tapar el zoom, en una
       franja al pie. Si se quiere la tarjeta idéntica a la referencia, basta
       con borrar ese bloque. */

const ACCENTS = {
  /* Contrastes comprobados sobre cada fondo: oro 10.9:1, cian 12.5:1 y
     violeta 6.4:1 con texto blanco (en violeta el texto oscuro fallaría). */
  gold: 'bg-star-500 text-on-primary',
  cyan: 'bg-cosmic-cyan text-ink-950',
  violet: 'bg-cosmic-violet text-white',
} as const;
---

<section id="proyectos" class="relative w-full py-24 md:py-28">
  <div class="shell">

    <!-- Cabecera -->
    <div class="mb-16 md:mb-20">
      <p class="eyebrow">Trabajos recientes</p>
      <h2 class="display-2 mt-4">Archivos del Estudio</h2>
    </div>

    <!-- Rejilla escalonada. La versión anterior usaba `columns` esperando que
         se empaquetara sola por altura, pero con dos casos parecidos quedaba
         en línea. Aquí el desfase se controla y siempre ocurre. -->
    <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2">
      {
        PROJECTS.map((p, i) => (
          <article
            class:list={[
              'group flex flex-col gap-6',
              i % 2 === 0 ? 'md:-mt-12' : 'md:mt-12',
            ]}
          >
            <div class="relative aspect-[4/5] overflow-hidden rounded-xl bg-ink-800">
              <img
                src={p.image}
                alt={p.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
              />

              {/* Degradado permanente: asienta la píldora sobre cualquier
                  imagen y ata la tarjeta al fondo de la página. */}
              <div
                class="absolute inset-0 bg-gradient-to-t from-ink-950 to-transparent opacity-60"
                aria-hidden="true"
              />

              {/* Franja con el resultado. Sube al pasar por encima sin tapar
                  el zoom, a diferencia del panel completo de la versión
                  anterior. En pantallas sin cursor no aparece: ahí el dato
                  va debajo del título. */}
              <div
                class="pointer-events-none absolute inset-x-0 bottom-0 hidden translate-y-3 bg-gradient-to-t from-ink-950 via-ink-950/90 to-transparent px-8 pb-24 pt-10 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100 lg:block"
              >
                <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-primary">
                  {p.role} · {p.year}
                </p>
                <p class="mt-2 text-[0.95rem] leading-snug text-ink-50">
                  {p.result}
                </p>
              </div>

              <span
                class:list={[
                  'absolute bottom-8 left-8 rounded-full px-4 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.1em]',
                  ACCENTS[p.accent],
                ]}
              >
                {p.category}
              </span>

              {/* La tarjeta entera es el enlace; el nombre accesible lo da
                  este enlace invisible, así no hay que repetir texto. */}
              {p.url && (
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="absolute inset-0"
                  aria-label={`Ver ${p.title} (se abre en una pestaña nueva)`}
                />
              )}
            </div>

            <div>
              <h3 class="text-2xl font-bold tracking-tight transition-colors group-hover:text-primary">
                {p.title}
              </h3>
              <p class="body-text mt-2 text-sm">{p.hook}</p>

              {/* Sin cursor no hay hover: el resultado se muestra siempre. */}
              <div class="lg:hidden">
                <p class="mt-3 text-sm text-ink-50">{p.result}</p>
                <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.12em] text-slate-400">
                  {p.role} · {p.year} · {p.tech}
                </p>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    {/* Portafolio personal, FUERA de la rejilla y centrado. Antes era una
        tarjeta más y caía debajo de la columna corta, dejando un hueco
        enorme al lado. */}
    <div class="mt-20 flex justify-center">
      <a
        href={PORTFOLIO_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="glass-card group flex w-full max-w-xl flex-col items-center gap-3 rounded-2xl p-8 text-center"
      >
        <Icon name="explore" class="text-3xl text-primary" />
        <h3 class="text-xl font-bold tracking-tight">¿Quieres ver más?</h3>
        <p class="body-text mx-auto text-sm">
          El resto del trabajo, con cada caso desglosado, está en el portafolio
          personal de Alex.
        </p>
        <span
          class="mt-1 inline-flex items-center gap-2 text-sm font-bold text-primary transition-all group-hover:gap-3.5"
        >
          Abrir portafolio
          <Icon name="arrow_forward" />
        </span>
      </a>
    </div>
  </div>
</section>
