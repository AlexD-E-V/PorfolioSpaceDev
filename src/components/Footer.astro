---
import Logo from './ui/Logo.astro';

const year = new Date().getFullYear();
---

<footer class="shell border-t border-white/5 py-12 text-center">
  <!-- Antes había un rombo genérico que no era de la marca. -->
  <Logo variant="iso" class="h-8 w-auto mx-auto mb-6 text-white/40" />

  <p class="text-xs uppercase tracking-[0.4em] text-white/55">
    Mizarium © {year}. La exploración es nuestra esencia.
  </p>

  <p class="mt-3 text-[10px] uppercase tracking-[0.3em] text-white/50">
    Antes Space DEV · Latitud 0°
  </p>
</footer>
