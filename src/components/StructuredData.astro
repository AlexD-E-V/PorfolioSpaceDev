---
/* Datos estructurados (JSON-LD).

   Es lo que permite a Google entender que Mizarium es una organización real
   con dirección, servicios y perfiles, en vez de "una web más". Sin esto, un
   buscador solo ve texto suelto.

   Se declara `ProfessionalService` en lugar de `Organization` a secas porque
   es más específico: describe a alguien que presta servicios, que es
   exactamente lo que el rediseño quiere comunicar. */

import { PORTFOLIO_URL } from '../data/projects';
import { PRIMARY_SERVICE, SECONDARY_SERVICES } from '../data/services';
import { CONTACT_EMAIL } from '../data/site';
import { TEAM } from '../data/team';

interface Props {
  description: string;
}

const { description } = Astro.props;
const site = Astro.site?.origin ?? 'https://mizarium.com';

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site}/#estudio`,
      name: 'Mizarium',
      alternateName: 'Space DEV',
      url: site,
      description,
      logo: `${site}/icon-512.png`,
      image: `${site}/og.png`,
      email: CONTACT_EMAIL,
      priceRange: '$$',
      /* Tiene que coincidir con lo que se ve en "Dónde estamos": declarar una
         ciudad y enseñar otra es de las cosas que un buscador penaliza. */
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Ambato',
        addressRegion: 'Tungurahua',
        addressCountry: 'EC',
      },
      geo: {
        '@type': 'GeoCoordinates',
        latitude: -1.2417,
        longitude: -78.6197,
      },
      areaServed: { '@type': 'Place', name: 'Global' },
      knowsLanguage: ['es', 'en'],
      /* Los perfiles salen del equipo: así declarar uno nuevo es editar
         `data/team.ts` y nada más. */
      sameAs: [...new Set([PORTFOLIO_URL, ...TEAM.flatMap((m) => Object.values(m.socials))])],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios',
        itemListElement: [PRIMARY_SERVICE, ...SECONDARY_SERVICES].map((s) => ({
          '@type': 'Offer',
          itemOffered: {
            '@type': 'Service',
            name: s.title,
            description: s.description,
          },
        })),
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${site}/#web`,
      url: site,
      name: 'Mizarium',
      inLanguage: 'es',
      publisher: { '@id': `${site}/#estudio` },
    },
  ],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>
