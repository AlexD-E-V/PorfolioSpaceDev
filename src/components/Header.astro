---
import Logo from './ui/Logo.astro';
import MobileMenu from './MobileMenu.tsx';
import { NAV_LINKS } from '../data/nav';
---

<header class="fixed top-6 left-1/2 z-50 w-[92%] max-w-6xl -translate-x-1/2">
  <nav
    class="glass-panel flex items-center justify-between rounded-2xl px-6 py-3.5 shadow-2xl md:px-8"
    aria-label="Principal"
  >
    <a
      href="#inicio"
      class="group flex cursor-pointer items-center"
      aria-label="Mizarium — volver al inicio"
    >
      <Logo
        variant="lockup"
        class="h-7 w-auto text-ink-50 transition-colors duration-300 group-hover:text-primary"
      />
    </a>

    <!-- Etiquetas en llano. Los nombres poéticos quedan para los títulos de
         sección: en el menú cuestan orientación. Ver docs/MIZARIUM.md §4. -->
    <div class="hidden items-center gap-8 md:flex lg:gap-10">
      {
        NAV_LINKS.map((link) => (
          <a
            href={`#${link.id}`}
            class="text-[0.95rem] font-medium text-ink-200 transition-colors hover:text-primary"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="hidden md:flex">
      <a
        href="#contacto"
        class="rounded-full bg-primary px-6 py-2.5 text-[0.95rem] font-bold text-on-primary shadow-glow-sm transition-all duration-300 hover:bg-star-300"
      >
        Empezar
      </a>
    </div>

    <MobileMenu client:load />
  </nav>
</header>
