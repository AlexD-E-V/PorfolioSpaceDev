---
import Icon from './ui/Icon.astro';
import DirectLink from './DirectLink.tsx';
import ContactForm from './ContactForm.tsx';
import FaqList from './FaqList.astro';
import StarMap from './effects/StarMap.astro';

/* Contacto absorbe la FAQ: las objeciones de compra —precio, plazo, propiedad
   del código, soporte— se responden en el momento exacto de la duda y no a
   media página de distancia. Con eso son cinco secciones y no seis. */
---

<section id="contacto" class="relative w-full py-24 md:py-28">
  <!-- Antes estos blobs iban en `fixed`, así que acompañaban al visitante por
       toda la página en vez de vivir solo aquí. -->
  <div
    class="absolute -left-20 top-1/4 -z-10 h-96 w-96 rounded-full bg-primary/[0.07] blur-[120px]"
  >
  </div>
  <div
    class="absolute -right-20 bottom-1/4 -z-10 h-96 w-96 rounded-full bg-secondary/[0.07] blur-[120px]"
  >
  </div>

  <div class="shell">

    <!-- Cabecera -->
    <div class="text-center">
      <div
        class="inline-flex items-center gap-2.5 rounded-full border border-primary/25 bg-primary/[0.06] px-4 py-1.5"
      >
        <span class="relative flex h-1.5 w-1.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary opacity-75"
          ></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-primary"></span>
        </span>
        <span class="eyebrow">Aceptando proyectos</span>
      </div>

      <h2 class="display-2 mt-7 mx-auto max-w-[18ch]">
        Dinos qué quieres <span class="text-cosmic">construir</span>
      </h2>

      <p class="lede mx-auto mt-6">
        Elige por dónde empezar y te respondemos en menos de 24 h con una
        primera valoración honesta — incluso si te decimos que no somos los
        adecuados.
      </p>
    </div>

    <div class="mt-14 grid gap-8 lg:grid-cols-[1.6fr_1fr] lg:items-start">

      <!-- Formulario -->
      <ContactForm client:load />

      <!-- Objeciones y datos -->
      <aside class="space-y-8">
        <div>
          <p class="eyebrow">Antes de escribir</p>
          <h3 class="mt-3 text-xl font-bold tracking-tight">
            Lo que suelen preguntarnos
          </h3>
          <div class="mt-5">
            <FaqList />
          </div>
        </div>

        <DirectLink client:idle />

        <div class="glass-panel rounded-xl p-6">
          <div class="mb-4 flex items-center gap-3">
            <Icon name="location_on" class="text-sm text-primary" />
            <h4 class="text-[10px] font-bold uppercase tracking-[0.2em] text-primary">
              Dónde estamos
            </h4>
          </div>

          <p class="text-sm font-light text-white/70">Ambato, Ecuador</p>
          <p class="mt-1 font-mono text-[11px] text-slate-400">
            LAT 1°14'30"S · LON 78°37'11"O
          </p>

          {/* Donde antes iba la frase de la latitud 0°. La carta estelar dice
              lo mismo —dónde estamos— sin tener que contarlo. */}
          <StarMap
            class="mt-5"
            label="Ambato"
            alt="Carta estelar con Ambato, Ecuador, marcado por una estrella sobre una nebulosa."
          />
        </div>
      </aside>
    </div>
  </div>
</section>
