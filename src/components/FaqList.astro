---
import Icon from './ui/Icon.astro';
import { FAQS } from '../data/faq';

/* <details>/<summary> nativo en vez del acordeón de React que había antes.
   Sale gratis: navegable con teclado, anunciado correctamente por lectores de
   pantalla, el contenido cerrado no queda en el orden de foco, y no hay altura
   máxima que recorte respuestas largas. El de antes fallaba en las cuatro. */
---

<div class="space-y-3">
  {
    FAQS.map((faq) => (
      <details
        name="faq"
        class="group glass-card overflow-hidden rounded-xl [&[open]]:border-primary/40"
      >
        <summary
          class="flex cursor-pointer list-none items-center justify-between gap-4 p-5 text-left [&::-webkit-details-marker]:hidden"
        >
          <span class="text-[0.95rem] font-bold tracking-tight">{faq.question}</span>
          <Icon
            name="expand_more"
            class="shrink-0 text-slate-400 transition-transform duration-300 group-open:rotate-180 group-open:text-primary"
          />
        </summary>
        <div class="flex gap-4 px-5 pb-5">
          <div class="w-px shrink-0 bg-gradient-to-b from-primary/70 to-transparent" />
          <p class="body-text text-sm">{faq.answer}</p>
        </div>
      </details>
    ))
  }
</div>
